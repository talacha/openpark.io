{
  "name": "@openpark/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "pnpm --filter @openpark/core build",
    "build": "node scripts/copy-registry.mjs && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openpark/core": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0",
    "@vercel/functions": "^2.0.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
