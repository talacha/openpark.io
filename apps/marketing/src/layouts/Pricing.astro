---
import Base from './Base.astro';
import { COPY, href, type Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const c = COPY[locale];
const APP = import.meta.env.PUBLIC_APP_URL ?? 'https://app.openpark.io';
const TRIAL = import.meta.env.PUBLIC_TRIAL_SIGNUP === 'true'; // closed preview: no trial form to link to
---
<Base locale={locale} title={`${c.pricing.title} · OpenPark`} description={c.pricing.lead} path="/pricing">
  <div class="wrap"><section>
    <h1>{c.pricing.title}</h1>
    <p class="lead">{c.pricing.lead}</p>
    <div class="card"><table><tbody>{c.pricing.plans.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody></table></div>
    <p class="muted">{c.pricing.note}</p>
    <p>{TRIAL ? <a class="btn primary" href={`${href(locale)}#trial`}>{c.hero.cta}</a> : <a class="btn primary" href={`${APP}/login`}>{c.closed.signin}</a>}</p>
  </section></div>
</Base>
