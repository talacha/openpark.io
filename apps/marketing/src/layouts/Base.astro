---
import '@openpark/ui/tokens.css';
import '@openpark/ui/plate.css';
import { COPY, LOCALES, NAMES, href, isRtl, type Locale } from '../i18n';

interface Props { locale: Locale; title: string; description: string; path?: string }
const { locale, title, description, path = '' } = Astro.props;
const c = COPY[locale];
const site = Astro.site!.toString().replace(/\/$/, '');
const APP = import.meta.env.PUBLIC_APP_URL ?? 'https://app.openpark.io';
// Feature flag: self-service trial. Off while OpenPark is a closed (friends-and-family) preview.
const TRIAL = import.meta.env.PUBLIC_TRIAL_SIGNUP === 'true';
---
<!doctype html>
<html lang={locale} dir={isRtl(locale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`${site}${href(locale, path)}`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={`${site}${href(l, path)}`} />)}
  </head>
  <body>
    <header class="top">
      <a class="brand" href={href(locale)}><img src="/favicon.svg" alt="" width="26" height="26" />OpenPark</a>
      <nav aria-label="Main">
        <a href={`${href(locale)}#how`}>{c.nav.how}</a>
        <a href={`${href(locale)}#deploy`}>{c.nav.deploy}</a>
        <a href={href(locale, '/pricing')}>{c.nav.pricing}</a>
        <a href="/self-hosting/">{c.nav.selfHost}</a>
        <select aria-label="Language" onchange="location.href=this.value">
          {LOCALES.map((l) => <option value={href(l, path)} selected={l === locale}>{NAMES[l]}</option>)}
        </select>
        {TRIAL ? <a class="btn primary" href={`${href(locale)}#trial`}>{c.nav.trial}</a> : <a class="btn primary" href={`${APP}/login`}>{c.closed.signin}</a>}
      </nav>
    </header>
    <slot />
    <footer class="foot"><span>{c.footer}</span><a href={APP}>app.openpark.io</a></footer>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font-sans); background: var(--bg); color: var(--ink); line-height: 1.55; }
  a { color: var(--accent); }
  h1 { font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.08; margin: 0 0 var(--space-4); letter-spacing: -0.02em; }
  h2 { font-size: 1.6rem; margin: 0 0 var(--space-4); letter-spacing: -0.01em; }
  h3 { font-size: 1.05rem; margin: 0 0 var(--space-2); }
  .wrap { max-inline-size: 1080px; margin-inline: auto; padding-inline: var(--space-4); }
  section { padding-block: var(--space-7); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; padding: var(--space-3) var(--space-5); border-block-end: 1px solid var(--line); background: var(--surface); }
  .top nav { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .top nav a:not(.btn) { color: var(--ink); text-decoration: none; }
  .brand { display: flex; align-items: center; gap: var(--space-2); font-weight: 800; color: var(--ink); text-decoration: none; font-size: 1.15rem; }
  .btn { display: inline-flex; align-items: center; min-block-size: 44px; padding-inline: 18px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-weight: 650; text-decoration: none; cursor: pointer; }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  select, input { font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); min-block-size: 44px; }
  :focus-visible { outline: 3px solid var(--info); outline-offset: 2px; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-6); align-items: center; }
  .lead { font-size: 1.15rem; color: var(--ink-2); max-inline-size: 56ch; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-4); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-5); box-shadow: var(--shadow); }
  .card p { margin: 0; color: var(--ink-2); }
  .steps { counter-reset: s; display: grid; gap: var(--space-4); padding: 0; list-style: none; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 44px 1fr; gap: var(--space-4); }
  .steps li::before { content: counter(s); display: grid; place-items: center; inline-size: 44px; block-size: 44px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 800; }
  .steps p { margin: 0; color: var(--ink-2); }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-5); box-shadow: var(--shadow); display: grid; gap: var(--space-3); }
  .panel .row { display: flex; justify-content: space-between; gap: var(--space-3); align-items: center; }
  .bar { block-size: 10px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .bar > i { display: block; block-size: 100%; background: var(--accent); }
  form { display: grid; gap: var(--space-3); max-inline-size: 440px; }
  label { display: grid; gap: 4px; color: var(--ink-2); font-size: 0.9rem; }
  .pwd { position: relative; display: block; } .pwd input { inline-size: 100%; padding-inline: 84px; }
  .pwd-toggle { position: absolute; inset-block: 4px; inset-inline-end: 4px; padding-inline: 12px; border: 0; border-radius: var(--radius-sm); background: var(--surface-2); color: var(--ink); font: inherit; font-size: 0.85rem; cursor: pointer; }
  .err { color: var(--danger); } .muted { color: var(--ink-2); }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  table { border-collapse: collapse; inline-size: 100%; } td { padding: 12px 0; border-block-end: 1px solid var(--line); } td:last-child { text-align: end; font-weight: 650; }
  .foot { display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; padding: var(--space-5); color: var(--ink-2); border-block-start: 1px solid var(--line); }
  @media (max-width: 800px) { .hero { grid-template-columns: minmax(0, 1fr); } .top { padding-inline: var(--space-4); } }
</style>
