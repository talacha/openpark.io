---
import PricingPage from '../../layouts/Pricing.astro';
import { LOCALES, type Locale } from '../../i18n';
export function getStaticPaths() {
  return LOCALES.filter((l) => l !== 'en').map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<PricingPage locale={locale} />
