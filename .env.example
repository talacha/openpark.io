# Change all three before exposing the stack to anyone.
POSTGRES_PASSWORD=change-me-owner
OPENPARK_APP_PASSWORD=change-me-app
JWT_SECRET=change-me-to-a-long-random-string

WEB_PORT=8080
# AI profile: point the API at the worker (compose service name) and pick a vision model.
# ALPR_URL=http://alpr:8000
# VLM_MODEL=qwen3.5:4b

# Self-service trial signup (anyone can create an organisation). Off by default: OpenPark is a closed preview where
# platform admins create organisations and people join by invitation. Turn on for your first-run setup, then off again.
TRIAL_SIGNUP=true
